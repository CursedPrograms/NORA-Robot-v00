<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for NORA, sampled from images/nora_avatar.jpg.
  Avatar palette: yellow, red hair, silver body, black.
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#090B11"/>  <!-- window / page background -->
  <colour name="panel"            value="#0F141E"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#1F273D"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#161C2C"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#F2EFE9"/>  <!-- primary text -->
  <colour name="text_sec"         value="#A8A394"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#6B6557"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#F7BF28"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#F9D163"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#D34E41"/>  <!-- second avatar colour: highlights, tags -->
  <colour name="accent3"          value="#C0C4C7"/>  <!-- third avatar colour -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#251F0E"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
